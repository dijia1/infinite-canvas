# 后端监听端口
PORT=8082

# 前端开发代理默认使用 http://127.0.0.1:8082，如后端开发端口不同，启动前端时可单独设置 API_BASE_URL。
# API_BASE_URL=http://127.0.0.1:8082

# Portal Gateway 负责登录和应用入口；本应用验证身份签名后识别 portal-admin 全局管理员。
# 本地业务角色仍在“成员管理”中维护，不配置管理员 UID 列表。

# 图片生成持久化任务的应用内 Worker 数量。修改后重启应用生效。
AI_TASK_WORKER_CONCURRENCY=4

# 单个图片生成任务最多等待多久；支持 Go duration，例如 30s、10m、1h。
AI_IMAGE_TASK_TIMEOUT=3m
WORKFLOW_ENABLED=true
WORKFLOW_GLOBAL_CONCURRENCY=4
WORKFLOW_RUN_CONCURRENCY=2

# Portal 专属服务凭据：从 Portal 管理后台创建应用时取得，仅服务端使用。
# APP_KEY 和 SECRET 为启动必填项；同一凭据用于网关身份验签、目录同步和回调。
# 部署本版本前必须确认 Portal 已为 infinite-canvas 注入签名身份。
# Portal 凭据轮换时，将本应用 SECRET 更新为有效凭据并重启。
PORTAL_DIRECTORY_URL=http://portal-api:3000/internal/directory/users
PORTAL_DIRECTORY_APP_KEY=infinite-canvas
PORTAL_DIRECTORY_SECRET=

# 数据库必须使用 Portal 之外的专属应用账号与 schema。DATABASE_DSN 为必填项，
# 生产环境必须改用真实密钥，绝不能将真实连接信息提交到 Git。
DATABASE_DSN=postgres://infinite_canvas_app:ChangeMe_123456@postgres:5432/internal_tools?sslmode=disable&search_path=infinite_canvas
# 每个应用实例的保守连接池上限；共享数据库时请确保所有实例的总和低于数据库连接数限制。
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m

# local 用于不连接 OSS 的本地开发；生产环境必须为 oss。
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=data/media

# 生产 OSS 配置。internal Endpoint 只供容器上传；public Endpoint 仅用于签名 URL。
# MEDIA_STORAGE=oss
# OSS_REGION=cn-hangzhou
# OSS_BUCKET=your-private-bucket
# OSS_INTERNAL_ENDPOINT=oss-cn-hangzhou-internal.aliyuncs.com
# OSS_PUBLIC_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_OBJECT_PREFIX=infinite-canvas
# OSS_SIGNED_URL_TTL=15m

# 视频任务最长自动等待时间；暂停后可继续检查原上游任务，不会重新生成。
AI_VIDEO_TASK_TIMEOUT=30m
