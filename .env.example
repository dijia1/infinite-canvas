# 管理员账号，首次启动会自动创建。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=infinite-canvas

# JWT 登录密钥和过期时间，正式部署请修改 JWT_SECRET。
JWT_SECRET=infinite-canvas
JWT_EXPIRE_HOURS=168

# 后端监听端口
PORT=8082

# 前端开发代理默认使用 http://127.0.0.1:8082，如后端开发端口不同，启动前端时可单独设置 API_BASE_URL。
# API_BASE_URL=http://127.0.0.1:8082

# 数据库配置，生产 Docker Compose 默认使用 PostgreSQL。
# 密码建议先使用字母、数字、下划线，避免 @ : / ? # & % 等 URL 特殊字符影响 DATABASE_DSN 解析。
STORAGE_DRIVER=postgres
POSTGRES_DB=infinite_canvas
POSTGRES_USER=infinite_canvas_user
POSTGRES_PASSWORD=ChangeMe_123456
DATABASE_DSN=postgres://infinite_canvas_user:ChangeMe_123456@postgres:5432/infinite_canvas?sslmode=disable

# 如需本地单进程开发临时使用 SQLite，可改为：
# STORAGE_DRIVER=sqlite
# DATABASE_DSN=data/infinite-canvas.db
